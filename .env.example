VITE_API_URL=http://localhost:8000

# Better Auth Configuration
AUTH_SECRET=your-secret-key-change-in-production
BASE_URL=http://localhost:8000

# Email Service
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@yourdomain.com

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI API Keys
GROQ_API_KEY=your-groq-api-key

# LiteLLM Configuration
LITELLM_MODEL=groq/llama-3.3-70b-versatile
LITELLM_SEARCH_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=gemini/text-embedding-004
LITELLM_PROXY_BASE=http://localhost:4000

# APIs Configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://slidesage:slidesage@localhost:5432/slidesage

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
