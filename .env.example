VITE_API_URL=http://localhost:8000
VITE_PROXY_TARGET=http://localhost:8000
NODE_ENV=development

# Better Auth Configuration
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BASE_URL=http://localhost:8000

# API Security
RATE_LIMIT_HASH_SECRET=your-independent-rate-limit-hash-secret
# Set only when Bun runs behind a proxy that replaces forwarded client-IP headers.
TRUST_PROXY_HEADERS=false

# Email Service
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@yourdomain.com
EMAIL_DELIVERY_TIMEOUT_MS=10000

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# APIs Configuration
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_USER=slidesage
POSTGRES_PASSWORD=slidesage
POSTGRES_DB=slidesage
DATABASE_URL=postgresql://slidesage:slidesage@localhost:5432/slidesage
DATABASE_CONNECT_TIMEOUT=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_POOL_MAX=5
# TEST_DATABASE_URL must target a disposable database whose name contains "test".
TEST_DATABASE_URL=postgresql://slidesage:slidesage@localhost:5432/slidesage_test

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare Deployment
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
POLICY_AUD=your-cloudflare-access-policy-audience
TEAM_DOMAIN=your-team.cloudflareaccess.com

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_REQUEST_TIMEOUT_MS=15000

# OpenRouter
OPEN_ROUTER_API_KEY=sk-XXXXXXXXXXXXXXXX
OPEN_ROUTER_MODEL=google/gemma-4-26b-a4b-it
OPEN_ROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions
OPEN_ROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
OPEN_ROUTER_MAX_ATTEMPTS=3
OPEN_ROUTER_MAX_OUTPUT_TOKENS=32768
OPEN_ROUTER_REQUEST_TIMEOUT_MS=180000
OPEN_ROUTER_STREAM_IDLE_TIMEOUT_MS=120000
OPEN_ROUTER_RETRY_BASE_DELAY_MS=1000
OPEN_ROUTER_RETRY_MAX_DELAY_MS=30000
OPEN_ROUTER_MAX_RESPONSE_BYTES=8388608
SSE_KEEPALIVE_INTERVAL_MS=10000
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_REQUEST_TIMEOUT_MS=15000
SEMANTIC_CACHE_MODE=serve
SEARCH_CACHE_SIMILARITY_THRESHOLD=0.94
OUTLINE_CACHE_SIMILARITY_THRESHOLD=0.94
SEARCH_CACHE_TTL_SECONDS=3600
OUTLINE_CACHE_TTL_SECONDS=604800

# Web Research
EXA_API_KEY=your-exa-api-key
EXA_REQUEST_TIMEOUT_MS=10000

# Base64-encoded 32-byte key used to encrypt per-user provider credentials.
BYOK_ENCRYPTION_KEY_CURRENT_VERSION=1
BYOK_ENCRYPTION_KEY_V1=
