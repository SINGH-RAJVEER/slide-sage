{
    "name": "slide-sage-apis",
    "version": "1.0.0",
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "deploy": "bunx --bun wrangler deploy --config wrangler.jsonc",
        "test": "bun test --isolate",
        "lint": "bunx --bun biome check .",
        "lint:fix": "bunx --bun biome check --write .",
        "format": "bunx --bun biome format --write ."
    },
    "dependencies": {
        "@slide-sage/database": "workspace:*",
        "@slide-sage/types": "workspace:*",
        "better-auth": "^1.4.18",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.36.4",
        "exa-js": "^2.15.0",
        "hono": "^4.6.14",
        "postgres": "^3.4.5",
        "razorpay": "^2.9.6",
        "resend": "^6.9.2"
    },
    "devDependencies": {
        "@types/bun": "1.3.13",
        "@biomejs/biome": "^2.4.7"
    },
    "packageManager": "bun@1.3.10"
}
