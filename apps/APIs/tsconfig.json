{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "lib": ["ESNext", "DOM"],
        "module": "esnext",
        "target": "esnext",
        "moduleDetection": "force",
        "composite": true,
        "downlevelIteration": true,
        "jsx": "preserve",
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "types": ["bun"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["src/scripts/**/*"]
}
