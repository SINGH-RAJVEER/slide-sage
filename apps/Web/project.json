{
    "name": "slide-sage-web",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "root": "apps/Web",
    "sourceRoot": "apps/Web/src",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/dist"],
            "options": {
                "command": "bunx vite build",
                "cwd": "{projectRoot}"
            }
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bunx vite",
                "cwd": "{projectRoot}"
            }
        },
        "preview": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bunx vite preview",
                "cwd": "{projectRoot}"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun test",
                "cwd": "{projectRoot}"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "biome check .",
                "cwd": "{projectRoot}"
            }
        },
        "format": {
            "executor": "nx:run-commands",
            "options": {
                "command": "biome format --write .",
                "cwd": "{projectRoot}"
            }
        }
    }
}
