{
	"name": "slidesage-api-legacy",
	"version": "0.0.1",
	"module": "src/index.ts",
	"type": "module",
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/index.ts",
		"deploy": "wrangler deploy --config wrangler.jsonc",
		"db:studio": "bunx --bun drizzle-kit studio --config drizzle.config.ts",
		"build:worker": "wrangler deploy --dry-run --config wrangler.jsonc",
		"test": "bun test --isolate",
		"test:integration:db": "bun test --isolate ./src/integration/postgres.integration.ts",
		"lint": "bunx --bun biome check .",
		"lint:fix": "bunx --bun biome check --write .",
		"format": "bunx --bun biome format --write ."
	},
	"dependencies": {
		"@slidesage/types": "workspace:*",
		"better-auth": "^1.4.18",
		"drizzle-orm": "^0.44.7",
		"hono": "^4.6.14",
		"postgres": "^3.4.5",
		"razorpay": "^2.9.6",
		"resend": "^6.9.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@types/bun": "1.3.13",
		"drizzle-kit": "^0.31.4",
		"wrangler": "^4.110.0"
	},
	"packageManager": "bun@1.3.10"
}
