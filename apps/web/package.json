{
    "name": "slide-sage-web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "src/main.tsx",
    "module": "src/main.tsx",
    "scripts": {
        "dev": "bunx --bun vite",
        "prebuild": "bun install --no-frozen-lockfile",
        "build": "NODE_ENV=production bunx --bun vite build",
        "preview": "bunx --bun vite preview",
        "test": "bun test --isolate",
        "test:watch": "bun test --watch --isolate",
        "lint": "bunx --bun biome check .",
        "lint:fix": "bunx --bun biome check --write .",
        "format": "bunx --bun biome format --write ."
    },
    "dependencies": {
        "@slide-sage/types": "workspace:*",
        "@slide-sage/ui": "workspace:*",
        "@tanstack/react-pacer": "^0.19.1",
        "@vitejs/plugin-react": "^4.5.2",
        "better-auth": "^1.4.18",
        "chart.js": "^4.5.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.514.0",
        "pptxgenjs": "^4.0.1",
        "react": "^19",
        "react-chartjs-2": "^5.3.0",
        "react-dom": "^19",
        "react-router-dom": "^7.6.2",
        "vite": "^6.3.5",
        "vite-tsconfig-paths": "^5.1.4",
        "zod": "^3.25.64"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "@happy-dom/global-registrator": "^20.1.0",
        "@tailwindcss/postcss": "^4.2.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@types/bun": "1.3.13",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "^1.0.0",
        "jszip": "^3.10.1",
        "lightningcss": "^1.30.2",
        "tailwindcss": "^4.0.0"
    },
    "packageManager": "bun@1.3.10"
}
