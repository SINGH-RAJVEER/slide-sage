{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "types": ["bun", "vite/client"],
        "allowJs": true,
        "module": "preserve",
        "paths": {
            "@/*": ["./src/*"],
            "@slide-sage/types": ["../../libs/types/src/index.ts"],
            "@slide-sage/ui": ["../../libs/ui/index.ts"],
            "@slide-sage/ui/components/*": ["../../libs/ui/components/*"],
            "@slide-sage/ui/hooks/*": ["../../libs/ui/hooks/*"],
            "@slide-sage/ui/lib/*": ["../../libs/ui/lib/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist", "node_modules"]
}
