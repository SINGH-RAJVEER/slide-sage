{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "types": ["react", "bun"],
        "paths": {
            "@slide-sage/types": ["../types/src/index.ts"],
            "@slide-sage/ui": ["./index.ts"],
            "@slide-sage/ui/components": ["./components"],
            "@slide-sage/ui/components/*": ["./components/*"],
            "@slide-sage/ui/hooks": ["./hooks"],
            "@slide-sage/ui/hooks/*": ["./hooks/*"],
            "@slide-sage/ui/lib": ["./lib"],
            "@slide-sage/ui/lib/*": ["./lib/*"]
        }
    },
    "include": [
        "*.ts",
        "components/**/*.ts",
        "components/**/*.tsx",
        "hooks/**/*.ts",
        "lib/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        "../types/src/**/*.ts"
    ],
    "exclude": ["../types/src/**/*.test.ts"]
}
