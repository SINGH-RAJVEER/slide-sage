{
    "name": "slidesage",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "libs/*"
    ],
    "scripts": {
        "build": "bun run build:web",
        "build:api": "CGO_ENABLED=0 go -C apps/api build ./...",
        "build:api-legacy": "bun --cwd apps/api-legacy build:worker",
        "build:web": "bun --cwd apps/web build",
        "deploy:api-legacy": "bun --cwd apps/api-legacy deploy",
        "dev": "just dev",
        "dev:stream": "bun run dev",
        "dev:api": "CGO_ENABLED=0 go -C apps/api run ./cmd/api",
        "dev:api-legacy": "bun --cwd apps/api-legacy dev",
        "dev:web": "bun --cwd apps/web dev",
        "test": "bun run test:api && bun run test:api-legacy && bun run test:types && bun run test:ui && bun run test:web",
        "test:api": "CGO_ENABLED=0 go -C apps/api test ./...",
        "test:api-legacy": "bun --cwd apps/api-legacy test",
        "test:web": "bun --cwd apps/web test",
        "test:types": "bun --cwd libs/types test",
        "test:integration:db:api-legacy": "bun --cwd apps/api-legacy test:integration:db",
        "test:ui": "bun --cwd libs/ui test",
        "type-check": "bun run type-check:api-legacy && bun run type-check:web && bun run type-check:types && bun run type-check:ui",
        "type-check:api-legacy": "bun node_modules/typescript/bin/tsc -p apps/api-legacy/tsconfig.json --tsBuildInfoFile node_modules/.cache/slidesage-api-legacy.tsbuildinfo",
        "type-check:web": "bun node_modules/typescript/bin/tsc -p apps/web/tsconfig.json --tsBuildInfoFile node_modules/.cache/slidesage-web.tsbuildinfo",
        "type-check:types": "bun node_modules/typescript/bin/tsc -p libs/types/tsconfig.json --tsBuildInfoFile node_modules/.cache/slidesage-types.tsbuildinfo",
        "type-check:ui": "bun node_modules/typescript/bin/tsc -p libs/ui/tsconfig.json --tsBuildInfoFile node_modules/.cache/slidesage-ui.tsbuildinfo",
        "lint": "bun run lint:api && bun run lint:api-legacy && bun --cwd apps/web lint && bun --cwd libs/types lint && bun --cwd libs/ui lint",
        "lint:api": "CGO_ENABLED=0 go -C apps/api vet ./...",
        "lint:api-legacy": "bun --cwd apps/api-legacy lint",
        "lint:web": "bun --cwd apps/web lint",
        "migrate:api": "bash apps/api/scripts/migrate.sh",
        "migration:create": "goose -dir apps/api/migrations create",
        "format": "bun run format:api && bun run format:api-legacy && bun --cwd apps/web format && bun --cwd libs/types format && bun --cwd libs/ui format",
        "format:api": "go -C apps/api fmt ./...",
        "format:api-legacy": "bun --cwd apps/api-legacy format",
        "format:web": "bun --cwd apps/web format"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "@types/bun": "1.3.13",
        "typescript": "^7.0.2"
    },
    "trustedDependencies": [],
    "packageManager": "bun@1.3.10"
}
