{
  "name": "slide-sage-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:apis": "turbo run build --filter=slide-sage-apis",
    "build:web": "turbo run build --filter=slide-sage-web",
    "deploy:apis": "bun --cwd apps/APIs run deploy",
    "dev": "turbo run dev --ui=tui",
    "dev:stream": "turbo run dev --ui=stream",
    "dev:apis": "turbo run dev --ui=tui --filter=slide-sage-apis",
    "dev:web": "turbo run dev --ui=tui --filter=slide-sage-web",
    "lint": "turbo run lint",
    "lint:apis": "turbo run lint --filter=slide-sage-apis",
    "lint:web": "turbo run lint --filter=slide-sage-web",
    "format": "turbo run format",
    "format:apis": "turbo run format --filter=slide-sage-apis",
    "format:web": "turbo run format --filter=slide-sage-web"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.3.10"
}
