{
    "name": "slide-sage",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "libs/*"
    ],
    "scripts": {
        "build": "bun run build:web",
        "build:web": "bun --cwd apps/web build",
        "deploy:api": "bun --cwd apps/api deploy",
        "dev": "just dev",
        "dev:stream": "bun run dev",
        "dev:api": "bun --cwd apps/api dev",
        "dev:web": "bun --cwd apps/web dev",
        "test": "bun run test:api && bun run test:web && bun run test:types",
        "test:api": "bun --cwd apps/api test",
        "test:web": "bun --cwd apps/web test",
        "test:types": "bun --cwd libs/types test",
        "type-check": "bun run type-check:api && bun run type-check:web && bun run type-check:types && bun run type-check:ui",
        "type-check:api": "bun node_modules/typescript/bin/tsc -p apps/api/tsconfig.json --tsBuildInfoFile node_modules/.cache/slide-sage-api.tsbuildinfo",
        "type-check:web": "bun node_modules/typescript/bin/tsc -p apps/web/tsconfig.json --tsBuildInfoFile node_modules/.cache/slide-sage-web.tsbuildinfo",
        "type-check:types": "bun node_modules/typescript/bin/tsc -p libs/types/tsconfig.json --tsBuildInfoFile node_modules/.cache/slide-sage-types.tsbuildinfo",
        "type-check:ui": "bun node_modules/typescript/bin/tsc -p libs/ui/tsconfig.json --tsBuildInfoFile node_modules/.cache/slide-sage-ui.tsbuildinfo",
        "lint": "bun --cwd apps/api lint && bun --cwd apps/web lint && bun --cwd libs/types lint && bun --cwd libs/ui lint",
        "lint:api": "bun --cwd apps/api lint",
        "lint:web": "bun --cwd apps/web lint",
        "format": "bun --cwd apps/api format && bun --cwd apps/web format && bun --cwd libs/types format && bun --cwd libs/ui format",
        "format:api": "bun --cwd apps/api format",
        "format:web": "bun --cwd apps/web format"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "@types/bun": "1.3.13",
        "typescript": "^7.0.2"
    },
    "trustedDependencies": [],
    "packageManager": "bun@1.3.10"
}
