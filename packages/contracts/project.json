{
    "name": "@slide-sage/contracts",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "root": "packages/contracts",
    "sourceRoot": "packages/contracts/src",
    "targets": {
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "biome check .",
                "cwd": "{projectRoot}"
            }
        },
        "format": {
            "executor": "nx:run-commands",
            "options": {
                "command": "biome format --write .",
                "cwd": "{projectRoot}"
            }
        }
    }
}
